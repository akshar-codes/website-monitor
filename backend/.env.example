# ─── Server ───
NODE_ENV=development
PORT=5000

# ─── MongoDB ───
MONGO_URI=mongodb://localhost:27017/website-monitor

# ─── Logging ───
# LOG_LEVEL: error | warn | info | http | verbose | debug | silly
# Defaults to "debug" in development and "http" in production if unset.
LOG_LEVEL=debug
# LOG_DIR: absolute or relative path for log files.
# Defaults to backend/logs if unset.
LOG_DIR=

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
API_RATE_LIMIT_MAX=300

# ─── Redis ───
# Reserved for a future background-queue integration (e.g. BullMQ). Not
# used by sessions — sessions are stored in MongoDB via connect-mongo.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── Monitoring Worker (HTTP health checks) ───
POLL_TICK_MS=10000
POLL_TIMEOUT_MS=10000
POLL_TOTAL_TIMEOUT_MS=30000
HEALTH_CHECK_MAX_RESPONSE_BYTES=1048576
MONITOR_JOB_CONCURRENCY=10
MONITOR_JOB_LEASE_MS=60000
MONITOR_JOB_RETRY_DELAY_MS=30000
MONITOR_RETRY_COUNT=2
MONITOR_RETRY_DELAY=1000
MONITOR_RETENTION_DAYS=365
MONITOR_DIAGNOSTIC_RETENTION_DAYS=30
MONITOR_RETENTION_BATCH_SIZE=500
MONITOR_MAINTENANCE_INTERVAL_MS=3600000
CONSECUTIVE_FAILURE_THRESHOLD=2
CONSECUTIVE_SUCCESS_THRESHOLD=2

# ─── SSL / Domain Monitoring Worker ───
# Runs on its own, much slower schedule than the HTTP health-check worker
# above — a certificate's expiry doesn't move between 10-second polls, so
# checking it that often would be wasted TLS handshakes and RDAP lookups.
# See backend/src/workers/sslScheduler.js.

# How often the SSL scheduler wakes up to look for due monitors (ms).
SSL_CHECK_TICK_MS=900000
# How often each individual monitor's certificate/domain is rechecked (ms).
# Defaults to 24 hours.
SSL_CHECK_INTERVAL_MS=86400000
# Timeout for the raw TLS handshake used to read a certificate (ms).
SSL_CHECK_TIMEOUT_MS=10000
SSL_CHECK_CONCURRENCY=3
# Timeout for the RDAP domain-registration lookup (ms).
DOMAIN_LOOKUP_TIMEOUT_MS=10000

# ─── CORS ───
# Comma-separated whitelist of origins allowed to make credentialed requests,
# e.g. "https://app.example.com,https://admin.example.com"
CORS_ORIGIN=http://localhost:5173

# ─── Request limits ───
# express.json()/urlencoded() body size limit (e.g. "1mb", "500kb").
MAX_BODY_SIZE=1mb

# ─── Reverse proxy ───
# Number of hops to trust for req.ip / X-Forwarded-*. Needed for
# express-rate-limit and secure cookies to see the real client address
# behind a load balancer/reverse proxy. Set to 0 if directly internet-facing.
TRUST_PROXY=1

# ─── Cookies ───
# Signs cookies via cookie-parser, so future auth (Passport session/refresh
# cookies) is tamper-evident. Required — min 32 chars. Generate with:
#   openssl rand -hex 32
COOKIE_SECRET=

# ─── Sessions & Authentication ───
# Signs the session-ID cookie (express-session). Required — min 32 chars.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Name of the session cookie.
SESSION_NAME=wm.sid

# Default session lifetime (no "remember me") in milliseconds, and idle
# timeout under the rolling-session model. Defaults to 1 day.
SESSION_DEFAULT_MAX_AGE_MS=86400000
# "Remember me" session lifetime in milliseconds — also the MongoStore
# fallback TTL. Defaults to 30 days.
SESSION_REMEMBER_ME_MAX_AGE_MS=2592000000

# Stricter rate limit applied only to /auth/login, /auth/register, the
# email-verification endpoints, and the OAuth initiate endpoints, to slow
# down credential-stuffing / spam.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ─── Client / Frontend ───
# Canonical origin of the frontend app — used to build links embedded in
# emails (e.g. the email-verification and password-reset links) AND the
# redirect target after an OAuth attempt (success or failure).
CLIENT_URL=http://localhost:5173

# ─── Email / SMTP ───
# BREAKING CHANGE: the server now fails to start without SMTP configured,
# since account verification email is no longer optional. For local dev,
# point these at a catch-all inbox like Mailtrap, Ethereal, or Mailhog.
SMTP_HOST=
SMTP_PORT=587
# "true" enables implicit TLS (typically port 465). Leave "false" for
# STARTTLS on port 587, which is the common default.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=WebMonitor

# ─── Email Verification ───
# How long an issued verification link stays valid. Defaults to 24 hours.
EMAIL_VERIFICATION_TOKEN_EXPIRES_MS=86400000
# Minimum time between resend requests for the same account. Defaults to 60s.
EMAIL_VERIFICATION_RESEND_COOLDOWN_MS=60000

# ─── Password Reset ───
# How long an issued password-reset link stays valid. Kept short since a
# reset link grants immediate account takeover if intercepted.
# Defaults to 1 hour.
PASSWORD_RESET_TOKEN_EXPIRES_MS=3600000

# ─── OAuth Providers ───
# Each provider is only registered with Passport once ALL three of its vars
# below (client ID, client secret, callback URL) are set. Leaving a
# provider's vars empty disables it entirely — the corresponding
# /api/auth/<provider> routes simply won't be mounted, and the frontend
# button for it should be hidden. This lets you enable providers
# independently and add new ones later with zero changes to existing config.

# Path on CLIENT_URL that the browser is redirected to after any OAuth
# attempt (success or failure) — e.g. http://localhost:5173/oauth/callback
OAUTH_CALLBACK_PATH=/oauth/callback

# Google OAuth 2.0 — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth App — create at https://github.com/settings/developers
# Authorization callback URL must exactly match GITHUB_CALLBACK_URL below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ─── Profile / Avatar Uploads ───
# Local-disk storage, served statically from /uploads/avatars (see app.js
# and middlewares/uploadAvatar.js). AVATAR_UPLOAD_DIR is relative to the
# backend project root.
AVATAR_UPLOAD_DIR=uploads/avatars
# Maximum accepted avatar file size, in bytes. Defaults to 2 MB.
AVATAR_MAX_FILE_SIZE_BYTES=2097152
